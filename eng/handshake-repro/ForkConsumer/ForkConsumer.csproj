<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>ForkConsumer</AssemblyName>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The "modern consumer": the fork's server + logger, reading with Microsoft.Build 18.4
         (binlog FileFormatVersion 25). We point it at older hosts whose writer format differs. -->
    <PackageReference Include="Microsoft.Build" Version="18.4.0" PrivateAssets="All" />
    <ProjectReference Include="../../../src/XenoAtom.MsBuildPipeLogger.Logger/XenoAtom.MsBuildPipeLogger.Logger.csproj" />
    <ProjectReference Include="../../../src/XenoAtom.MsBuildPipeLogger/XenoAtom.MsBuildPipeLogger.csproj" />
  </ItemGroup>
</Project>
